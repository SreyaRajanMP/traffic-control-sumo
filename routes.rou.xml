<?xml version="1.0" encoding="UTF-8"?>
<routes>
    <!-- Vehicle Types with different colors -->
    <vType id="car_blue" vClass="passenger" color="0,0,255" length="4.5" accel="2.6" decel="15.0" maxSpeed="12"/>
    <vType id="car_green" vClass="passenger" color="0,255,0" length="4.5" accel="2.6" decel="15.0" maxSpeed="12"/>
    <vType id="car_yellow" vClass="passenger" color="255,255,0" length="4.5" accel="2.6" decel="15.0" maxSpeed="12"/>
    <vType id="car_cyan" vClass="passenger" color="0,255,255" length="4.5" accel="2.6" decel="15.0" maxSpeed="12"/>
    <vType id="car_magenta" vClass="passenger" color="255,0,255" length="4.5" accel="2.6" decel="15.0" maxSpeed="12"/>
    <vType id="car_white" vClass="passenger" color="255,255,255" length="4.5" accel="2.6" decel="15.0" maxSpeed="12"/>
    
    <vType id="bus" vClass="bus" color="0,0,255" length="12.0" accel="1.2" decel="14.0" maxSpeed="12"/>
    <vType id="truck" vClass="truck" color="255,255,0" length="7.5" accel="1.3" decel="14.0" maxSpeed="12"/>
    <vType id="emergency" vClass="emergency" color="255,0,0" length="5.5" accel="3.0" decel="15.0" maxSpeed="15"/>

    <!-- Routes from each direction -->
    <route id="route_N_S" edges="N2J J2S"/>
    <route id="route_N_E" edges="N2J J2E"/>
    <route id="route_N_W" edges="N2J J2W"/>
    
    <route id="route_S_N" edges="S2J J2N"/>
    <route id="route_S_E" edges="S2J J2E"/>
    <route id="route_S_W" edges="S2J J2W"/>
    
    <route id="route_E_W" edges="E2J J2W"/>
    <route id="route_E_N" edges="E2J J2N"/>
    <route id="route_E_S" edges="E2J J2S"/>
    
    <route id="route_W_E" edges="W2J J2E"/>
    <route id="route_W_N" edges="W2J J2N"/>
    <route id="route_W_S" edges="W2J J2S"/>

    <!-- Vehicle Flows from NORTH - mixed types -->
    <flow id="flow_N_S_blue" type="car_blue" route="route_N_S" begin="0" end="2000" probability="0.14"/>
    <flow id="flow_N_S_green" type="car_green" route="route_N_S" begin="0" end="2000" probability="0.09"/>
    <flow id="flow_N_E" type="car_yellow" route="route_N_E" begin="0" end="2000" probability="0.13"/>
    <flow id="flow_N_W" type="car_cyan" route="route_N_W" begin="0" end="2000" probability="0.15"/>
    <flow id="flow_N_bus" type="bus" route="route_N_S" begin="0" end="2000" probability="0.10"/>
    <flow id="flow_N_truck" type="truck" route="route_N_S" begin="0" end="2000" probability="0.13"/>
    
    <!-- Vehicle Flows from SOUTH - mixed types -->
    <flow id="flow_S_N_blue" type="car_blue" route="route_S_N" begin="0" end="2000" probability="0.15"/>
    <flow id="flow_S_N_magenta" type="car_magenta" route="route_S_N" begin="0" end="2000" probability="0.13"/>
    <flow id="flow_S_E" type="car_white" route="route_S_E" begin="0" end="2000" probability="0.07"/>
    <flow id="flow_S_bus" type="bus" route="route_S_N" begin="0" end="2000" probability="0.10"/>
    
    <!-- Vehicle Flows from EAST - mixed types -->
    <flow id="flow_E_W_green" type="car_green" route="route_E_W" begin="0" end="2000" probability="0.14"/>
    <flow id="flow_E_W_yellow" type="car_yellow" route="route_E_W" begin="0" end="2000" probability="0.14"/>
    <flow id="flow_E_N" type="car_blue" route="route_E_N" begin="0" end="2000" probability="0.07"/>
    <flow id="flow_E_S" type="car_cyan" route="route_E_S" begin="0" end="2000" probability="0.08"/>
    <flow id="flow_E_truck" type="truck" route="route_E_W" begin="0" end="2000" probability="0.14"/>
    
    <!-- Vehicle Flows from WEST - mixed types -->
    <flow id="flow_W_E_white" type="car_white" route="route_W_E" begin="0" end="2000" probability="0.19"/>
    <flow id="flow_W_N" type="car_magenta" route="route_W_N" begin="0" end="2000" probability="0.10"/>
    <flow id="flow_W_S" type="car_green" route="route_W_S" begin="0" end="2000" probability="0.24"/>
    <flow id="flow_W_bus" type="bus" route="route_W_E" begin="0" end="2000" probability="0.13"/>
    
    <!-- GUARANTEED Emergency Vehicles - at least one will spawn -->
    <vehicle id="ambulance_1" type="emergency" route="route_N_S" depart="47" color="255,0,0"/>
    <vehicle id="ambulance_2" type="emergency" route="route_E_W" depart="183" color="255,0,0"/>
    <vehicle id="ambulance_3" type="emergency" route="route_S_N" depart="361" color="255,0,0"/>
    <vehicle id="ambulance_4" type="emergency" route="route_W_E" depart="589" color="255,0,0"/>
    
    <!-- Additional random emergency vehicles -->
    <flow id="emergency_random" type="emergency" route="route_N_S" begin="100" end="2000" probability="0.18"/>
    <flow id="emergency_random_2" type="emergency" route="route_E_W" begin="0" end="2000" probability="0.16"/>
    <flow id="emergency_random_3" type="emergency" route="route_S_N" begin="0" end="2000" probability="0.18"/>
    <flow id="emergency_random_4" type="emergency" route="route_W_E" begin="0" end="2000" probability="0.15"/>
</routes>